#!/usr/bin/env python3
"""rex-sessions launcher: runs the in-repo package without installing it.

The real path is resolved so a symlink in ~/.local/bin (see install.sh) still
finds rex_sessions/ next to this file; `jj`/`git` updates take effect at once.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from rex_sessions.cli import main  # noqa: E402

sys.exit(main())
